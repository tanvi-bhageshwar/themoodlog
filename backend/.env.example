# Environment Configuration for MoodLog Backend

# Application Secrets
SECRET_KEY=moodlog-development-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite default for local development)
DATABASE_URL=sqlite:///./moodlog.db

# AI API Providers (Groq or Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security and CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000
ENVIRONMENT=development
